<main class="main-content restaurant-detail-page">
  <!-- Restaurant Header -->
  <div class="restaurant-detail-header">
    <button class="btn-back" id="btnBackFromDetail">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <!-- Image Carousel -->
    <div class="restaurant-carousel">
      <div class="carousel-container" id="restaurantCarousel">
        <div class="carousel-slide active">
          <img src="{{restaurant.image}}" alt="{{restaurant.name}} - 1" />
        </div>
        <div class="carousel-slide">
          <img
            src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=400"
            alt="{{restaurant.name}} - 2"
          />
        </div>
        <div class="carousel-slide">
          <img
            src="https://images.unsplash.com/photo-1559339352-11d035aa65de?w=400"
            alt="{{restaurant.name}} - 3"
          />
        </div>
      </div>

      <!-- Carousel Indicators -->
      <div class="carousel-indicators">
        <span class="indicator active" data-slide="0"></span>
        <span class="indicator" data-slide="1"></span>
        <span class="indicator" data-slide="2"></span>
      </div>

      <button
        class="btn-bookmark-detail"
        data-id="{{restaurant.id}}"
        aria-label="Yêu thích"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Restaurant Info -->
  <div class="restaurant-detail-content">
    <div class="restaurant-info-header">
      <h1 class="restaurant-detail-name">{{restaurant.name}}</h1>
      <div class="restaurant-meta">
        <div class="restaurant-rating">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <polygon
              points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
            ></polygon>
          </svg>
          <span class="rating-value">{{restaurant.average_rating}}</span>
          <span class="rating-count">({{restaurant.review_count}}
            đánh giá)</span>
        </div>
        <div class="restaurant-cuisine-tag">{{restaurant.cuisine}}</div>
      </div>
      <div class="restaurant-price">{{restaurant.priceRange}}</div>
    </div>

    <!-- Restaurant Description -->
    {{#if restaurant.description}}
      <div class="restaurant-description-section">
        <h3>Giới thiệu</h3>
        <p>{{restaurant.description}}</p>
      </div>
    {{/if}}

    <!-- Restaurant Address & Contact -->
    <div class="restaurant-contact-section">
      <h3>Thông tin liên hệ</h3>
      <div class="contact-item">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>{{restaurant.address}}</span>
      </div>
      <div class="contact-item">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
          ></path>
        </svg>
        <a href="tel:{{restaurant.phone}}">{{restaurant.phone}}</a>
      </div>
    </div>

    <!-- Tags -->
    {{#if restaurant.tags}}
      <div class="restaurant-tags-section">
        <h3>Đặc điểm</h3>
        <div class="tags-list">
          {{#each (split restaurant.tags ",")}}
            <span class="tag">{{this}}</span>
          {{/each}}
        </div>
      </div>
    {{/if}}

    <!-- Deposit Info -->
    {{#if restaurant.require_deposit}}
      <div class="deposit-info-section">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>Yêu cầu đặt cọc:
          {{formatCurrency restaurant.default_deposit_amount}}</span>
      </div>
    {{/if}}
  </div>

  <!-- Booking Button -->
  <div class="restaurant-detail-footer">
    <button
      class="btn-book-restaurant"
      id="btnBookRestaurant"
      data-id="{{restaurant.id}}"
    >
      Đặt bàn ngay
    </button>
  </div>
</main>