<main class="main-content">
  <!-- Notification Header -->
  <div class="page-header">
    <div class="header-left">
      <button class="btn-back" id="btnBack" aria-label="Quay lại">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
      </button>
    </div>
    <h1 class="page-title">Thông báo</h1>
    <div class="header-actions">
      <button
        class="btn-mark-all-read"
        id="btnMarkAllRead"
        aria-label="Đọc tất cả"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </button>
    </div>
  </div>
  <!-- Notifications List -->
  <section class="notifications-section" id="notificationsList">
    <!-- Will be rendered dynamically -->
  </section>
</main>

<!-- Floating Delete All Button (outside main-content to avoid animation) -->
<button
  class="btn-delete-all-floating"
  id="btnClearAll"
  aria-label="Xóa tất cả"
>
  <svg
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
  >
    <polyline points="3 6 5 6 21 6"></polyline>
    <path
      d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
    ></path>
  </svg>
</button>