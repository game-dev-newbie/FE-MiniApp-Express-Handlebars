<main class="main-content">
  <!-- Notification Header -->
  <div class="page-header">
    <button class="btn-back" id="btnBack" aria-label="Quay lại">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
    </button>
    <h1 class="page-title">Thông báo</h1>
    <button class="btn-mark-read" id="btnMarkAllRead" aria-label="Đánh dấu đã đọc">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </button>
  </div>

  <!-- Notifications List -->
  <section class="notifications-section">
    {{#if notifications.length}}
      <div class="notifications-list">
        {{#each notifications}}
          <div class="notification-item {{#unless this.is_read}}unread{{/unless}}" data-id="{{this.id}}">
            <div class="notification-icon {{this.type}}">
              {{#if (eq this.type "BOOKING_CONFIRMED")}}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              {{else if (eq this.type "BOOKING_REMINDER")}}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              {{else if (eq this.type "PROMOTION")}}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                  <line x1="7" y1="7" x2="7.01" y2="7"></line>
                </svg>
              {{else}}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                  <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
              {{/if}}
            </div>
            <div class="notification-content">
              <h3 class="notification-title">{{this.title}}</h3>
              <p class="notification-message">{{this.message}}</p>
              <span class="notification-time">{{this.created_at}}</span>
            </div>
            {{#unless this.is_read}}
              <div class="unread-dot"></div>
            {{/unless}}
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="empty-state">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        <h3>Chưa có thông báo</h3>
        <p>Bạn sẽ nhận được thông báo về đặt bàn và ưu đãi tại đây</p>
      </div>
    {{/if}}
  </section>
</main>
