<main class="main-content auth-page">
  <!-- Auth Content -->
  <div class="auth-content">
    <!-- Logo -->
    <div class="auth-logo">
      <img src="/src/assets/images/logo1.png" alt="DineLink Logo" class="auth-logo-img" />
    </div>

    <h1 class="auth-title">Đăng nhập</h1>
    <p class="auth-subtitle">Chào mừng trở lại! Đăng nhập để tiếp tục</p>

    <!-- Zalo Login (Primary) -->
    <button class="btn-zalo-login" id="btnZaloLogin">
      <img src="/src/assets/icons/Icon_of_Zalo.svg.png" alt="Zalo" class="zalo-icon" />
      <span>Đăng nhập với Zalo</span>
    </button>

    <!-- Divider -->
    <div class="auth-divider">
      <span>hoặc</span>
    </div>

    <!-- Email Login Form -->
    <form class="auth-form" id="loginForm">
      <div class="form-group">
        <label for="loginEmail">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          Email
        </label>
        <input
          type="email"
          id="loginEmail"
          name="email"
          placeholder="your.email@example.com"
          required
          autocomplete="email"
        />
      </div>

      <div class="form-group">
        <label for="loginPassword">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          Mật khẩu
        </label>
        <input
          type="password"
          id="loginPassword"
          name="password"
          placeholder="Nhập mật khẩu"
          required
          autocomplete="current-password"
        />
      </div>

      <button type="submit" class="btn-submit-auth" id="btnSubmitLogin">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
          <polyline points="10 17 15 12 10 7"></polyline>
          <line x1="15" y1="12" x2="3" y2="12"></line>
        </svg>
        Đăng nhập
      </button>
    </form>

    <!-- Footer Links -->
    <div class="auth-footer-links">
      <div class="auth-switch">
        <p>Chưa có tài khoản? <a href="#/register" class="auth-link">Đăng ký ngay</a></p>
      </div>

      <div class="auth-divider-text">
        <span>hoặc</span>
      </div>

      <a href="#/home" class="btn-guest-mode">
        Tiếp tục với chế độ khách
      </a>
    </div>
  </div>
</main>
