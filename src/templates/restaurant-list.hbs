<div class="restaurant-list">
  {{#if restaurants.length}}
    {{#each restaurants}}
      <article class="restaurant-card">
        <h2 class="restaurant-name">{{this.name}}</h2>
        <p class="restaurant-address">{{this.address}}</p>
        {{#if this.description}}
          <p class="restaurant-desc">{{this.description}}</p>
        {{/if}}
        <button class="btn btn-primary" data-id="{{this.id}}">
          Đặt bàn
        </button>
      </article>
    {{/each}}
  {{else}}
    <p>Hiện chưa có nhà hàng nào.</p>
  {{/if}}
</div>