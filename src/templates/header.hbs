<header class="header">
  <div class="header-left">
    <div class="logo">
      <img
        src="/src/assets/images/logo2.png"
        alt="DineLink Logo"
        class="logo-image"
      />
      <span class="brand-name">DineLink</span>
    </div>
  </div>
  <div class="header-right">
    <button class="header-icon-btn" id="notificationBtn" aria-label="Thông báo">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
      </svg>
      <span class="notification-badge">3</span>
    </button>
    <button class="header-icon-btn" id="bookmarkBtn" aria-label="Yêu thích">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
        ></path>
      </svg>
    </button>
    <button class="header-avatar-btn" id="profileBtn" aria-label="Tài khoản">
      <img src="{{userAvatar}}" alt="{{userName}}" class="avatar-image" />
    </button>
  </div>
</header>