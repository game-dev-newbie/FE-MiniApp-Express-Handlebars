<main class="main-content auth-page">
  <!-- Auth Content -->
  <div class="auth-content">
    <!-- Logo -->
    <div class="auth-logo">
      <img
        src="/src/assets/images/logo1.png"
        alt="DineLink Logo"
        class="auth-logo-img"
      />
    </div>

    <h1 class="auth-title">Đăng ký</h1>
    <p class="auth-subtitle">Tạo tài khoản mới để bắt đầu</p>

    <!-- Zalo Register (Primary) -->
    <button class="btn-zalo-login" id="btnZaloRegister">
      <img
        src="/src/assets/icons/Icon_of_Zalo.svg.png"
        alt="Zalo"
        class="zalo-icon"
      />
      <span>Đăng ký với Zalo</span>
    </button>

    <!-- Divider -->
    <div class="auth-divider">
      <span>hoặc</span>
    </div>

    <!-- Email Register Form -->
    <form class="auth-form" id="registerForm">
      <div class="form-group">
        <label for="registerName">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          Họ và tên
        </label>
        <input
          type="text"
          id="registerName"
          name="displayName"
          placeholder="Nguyễn Văn A"
          required
          autocomplete="name"
        />
      </div>

      <div class="form-group">
        <label for="registerEmail">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
            ></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          Email
        </label>
        <input
          type="email"
          id="registerEmail"
          name="email"
          placeholder="your.email@example.com"
          required
          autocomplete="email"
        />
      </div>

      <div class="form-group">
        <label for="registerPassword">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          Mật khẩu
        </label>
        <input
          type="password"
          id="registerPassword"
          name="password"
          placeholder="Tối thiểu 6 ký tự"
          required
          minlength="6"
          autocomplete="new-password"
        />
      </div>

      <div class="form-group">
        <label for="registerPasswordConfirm">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          Xác nhận mật khẩu
        </label>
        <input
          type="password"
          id="registerPasswordConfirm"
          name="passwordConfirm"
          placeholder="Nhập lại mật khẩu"
          required
          minlength="6"
          autocomplete="new-password"
        />
      </div>

      <button type="submit" class="btn-submit-auth" id="btnSubmitRegister">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        Đăng ký
      </button>
    </form>

    <!-- Footer Links -->
    <div class="auth-footer-links">
      <div class="auth-switch">
        <p>Đã có tài khoản?
          <a href="#/login" class="auth-link">Đăng nhập ngay</a></p>
      </div>

      <div class="auth-divider-text">
        <span>hoặc</span>
      </div>

      <a href="#/home" class="btn-guest-mode">
        Tiếp tục với chế độ khách
      </a>
    </div>
  </div>
</main>