<div class="onboarding-container active" id="onboardingContainer">
  <!-- Slide 1 -->
  <div class="onboarding-slide active" data-slide="1">
    <div class="onboarding-image-container">
      <div class="onboarding-image onboarding-image-1" id="onboardingImage1">
      </div>
    </div>
    <div class="onboarding-content">
      <h1 class="onboarding-title">Book a table in seconds</h1>
      <p class="onboarding-description">
        Chọn nhà hàng bạn thích và đặt bàn chỉ với vài chạm.<br />
        Nhanh chóng – tiện lợi – không cần gọi điện.
      </p>
    </div>
  </div>

  <!-- Slide 2 -->
  <div class="onboarding-slide" data-slide="2">
    <div class="onboarding-image-container">
      <div class="onboarding-image onboarding-image-2" id="onboardingImage2">
      </div>
    </div>
    <div class="onboarding-content">
      <h1 class="onboarding-title">Discover amazing restaurants</h1>
      <p class="onboarding-description">
        Khám phá hàng trăm nhà hàng cao cấp.<br />
        Từ ẩm thực Á đến Âu – đa dạng lựa chọn.
      </p>
    </div>
  </div>

  <!-- Slide 3 -->
  <div class="onboarding-slide" data-slide="3">
    <div class="onboarding-image-container">
      <div class="onboarding-image onboarding-image-3" id="onboardingImage3">
      </div>
    </div>
    <div class="onboarding-content">
      <h1 class="onboarding-title">Exclusive deals & rewards</h1>
      <p class="onboarding-description">
        Nhận ưu đãi đặc biệt và tích điểm thưởng.<br />
        Càng đặt nhiều – càng tiết kiệm.
      </p>
    </div>
  </div>

  <!-- Pagination Dots -->
  <div class="onboarding-pagination">
    <span class="dot active" data-slide="1"></span>
    <span class="dot" data-slide="2"></span>
    <span class="dot" data-slide="3"></span>
  </div>

  <!-- Navigation Buttons -->
  <div class="onboarding-buttons">
    <button class="onboarding-btn action-btn" id="actionBtn">Skip</button>
  </div>
</div>