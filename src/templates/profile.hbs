<main class="main-content profile-page">
  <!-- Profile Header -->
  <section class="profile-header">
    <div class="profile-avatar-large">
      <img
        src="{{user.avatar_url}}"
        alt="{{user.display_name}}"
        class="avatar-image-large"
      />
      <button class="btn-edit-avatar" aria-label="Đổi ảnh">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M12 20h9"></path>
          <path
            d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
          ></path>
        </svg>
      </button>
    </div>
    <h1 class="profile-name">{{user.display_name}}</h1>
    <p class="profile-email">{{user.email}}</p>
  </section>

  <!-- Profile Stats -->
  <section class="profile-stats">
    <div class="stat-item">
      <div class="stat-value">{{stats.bookings}}</div>
      <div class="stat-label">Đặt bàn</div>
    </div>
    <div class="stat-item">
      <div class="stat-value">{{stats.reviews}}</div>
      <div class="stat-label">Đánh giá</div>
    </div>
    <div class="stat-item">
      <div class="stat-value">{{stats.favorites}}</div>
      <div class="stat-label">Yêu thích</div>
    </div>
  </section>

  <!-- Profile Menu -->
  <section class="profile-menu">
    <div class="menu-group">
      <h3 class="menu-group-title">Tài khoản</h3>
      <button class="menu-item" id="editProfileBtn">
        <div class="menu-item-icon">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <div class="menu-item-content">
          <span class="menu-item-title">Thông tin cá nhân</span>
          <span class="menu-item-subtitle">Cập nhật thông tin của bạn</span>
        </div>
        <svg
          class="menu-item-arrow"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <button class="menu-item" id="changePasswordBtn">
        <div class="menu-item-icon">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <div class="menu-item-content">
          <span class="menu-item-title">Đổi mật khẩu</span>
        </div>
        <svg
          class="menu-item-arrow"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <div class="menu-group">
      <h3 class="menu-group-title">Hoạt động</h3>
      <button class="menu-item" id="myBookingsBtn">
        <div class="menu-item-icon">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        </div>
        <div class="menu-item-content">
          <span class="menu-item-title">Lịch sử đặt bàn</span>
        </div>
        <svg
          class="menu-item-arrow"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <button class="menu-item" id="myReviewsBtn">
        <div class="menu-item-icon">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polygon
              points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
            ></polygon>
          </svg>
        </div>
        <div class="menu-item-content">
          <span class="menu-item-title">Đánh giá của tôi</span>
        </div>
        <svg
          class="menu-item-arrow"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <button class="menu-item" id="myFavoritesBtn">
        <div class="menu-item-icon">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
            ></path>
          </svg>
        </div>
        <div class="menu-item-content">
          <span class="menu-item-title">Nhà hàng yêu thích</span>
        </div>
        <svg
          class="menu-item-arrow"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <div class="menu-group">
      <h3 class="menu-group-title">Hỗ trợ</h3>
      <button class="menu-item" id="helpBtn">
        <div class="menu-item-icon">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
        </div>
        <div class="menu-item-content">
          <span class="menu-item-title">Trợ giúp</span>
        </div>
        <svg
          class="menu-item-arrow"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <button class="menu-item" id="settingsBtn">
        <div class="menu-item-icon">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="3"></circle>
            <path
              d="M12 1v6m0 6v6m0-13a2 2 0 0 0-2 2v8a2 2 0 0 0 4 0V4a2 2 0 0 0-2-2z"
            ></path>
          </svg>
        </div>
        <div class="menu-item-content">
          <span class="menu-item-title">Cài đặt</span>
        </div>
        <svg
          class="menu-item-arrow"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <div class="menu-group">
      <button class="menu-item logout" id="logoutBtn">
        <div class="menu-item-icon logout-icon">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
        </div>
        <div class="menu-item-content">
          <span class="menu-item-title logout-text">Đăng xuất</span>
        </div>
      </button>
    </div>
  </section>
</main>