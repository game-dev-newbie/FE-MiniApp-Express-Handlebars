<main class="main-content">
  <!-- Category Header -->
  <div class="category-header category-header-center">
    <button class="btn-back" id="btnBack" aria-label="Quay lại">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
    </button>
    <h1 class="category-title">{{categoryName}}</h1>
    <div class="header-spacer"></div>
  </div>

  <!-- Restaurant Grid -->
  <section class="restaurant-grid-section">
    <div class="section-info">
      <p class="result-count">Tìm thấy {{restaurants.length}} nhà hàng</p>
    </div>

    <div class="restaurant-grid">
      {{#each restaurants}}
        <div class="grid-card" data-id="{{this.id}}">
          <div class="grid-card-image" style="background-image: url('{{this.image}}');">
            <button class="bookmark-btn" data-id="{{this.id}}" aria-label="Yêu thích">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </button>
          </div>
          <div class="grid-card-content">
            <h3 class="grid-card-title">{{this.name}}</h3>
            <div class="grid-card-info">
              <span class="rating">⭐ {{this.average_rating}}</span>
            </div>
            <p class="grid-card-cuisine">{{this.cuisine}}</p>
            <div class="grid-card-hours">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span>{{this.opening_hours}} - {{this.closing_hours}}</span>
            </div>
            <div class="grid-card-footer">
              <span class="price">{{this.priceRange}}</span>
              <button class="btn-book-small" data-id="{{this.id}}">Đặt bàn</button>
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  </section>
</main>
