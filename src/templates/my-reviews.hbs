<main class="main-content my-reviews-page">
  <!-- Header -->
  <div class="page-header">
    <button class="btn-back" onclick="window.location.hash='#/profile'">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <h1 class="page-title">Đánh giá của tôi</h1>
    <div class="header-spacer"></div>
  </div>

  <!-- Reviews List -->
  <section class="reviews-content">
    {{#if reviews.length}}
      <div class="reviews-list">
        {{#each reviews}}
          <div class="review-card" data-review-id="{{this.id}}">
            <div class="review-header">
              <img
                src="{{this.restaurantImage}}"
                alt="{{this.restaurantName}}"
                class="review-restaurant-image"
              />
              <div class="review-restaurant-info">
                <h3 class="review-restaurant-name">{{this.restaurantName}}</h3>
                <div class="review-rating">
                  {{#each this.stars}}
                    <span class="star filled">★</span>
                  {{/each}}
                  {{#each this.emptyStars}}
                    <span class="star">★</span>
                  {{/each}}
                </div>
                <span class="review-date">{{this.createdAt}}</span>
              </div>
            </div>
            {{#if this.comment}}
              <p class="review-comment">{{this.comment}}</p>
            {{/if}}
            <div class="review-actions">
              <button
                class="btn-review-action btn-view-booking-detail"
                data-booking-id="{{this.bookingId}}"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                Xem chi tiết
              </button>
              <button
                class="btn-review-action btn-delete-review"
                data-review-id="{{this.id}}"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
                Xóa
              </button>
              <button
                class="btn-review-action btn-view-restaurant"
                data-restaurant-id="{{this.restaurantId}}"
              >
                Xem nhà hàng
              </button>
            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="empty-state">
        <svg
          width="64"
          height="64"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <polygon
            points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
          ></polygon>
        </svg>
        <h3>Chưa có đánh giá nào</h3>
        <p>Hãy đặt bàn và trải nghiệm để đánh giá nhà hàng</p>
        <button class="btn-primary btn-explore-reviews" onclick="window.location.hash='#/'">Đặt bàn ngay</button>
      </div>
    {{/if}}
  </section>
</main>
