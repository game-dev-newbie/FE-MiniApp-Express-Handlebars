<!-- Booking Detail View Page -->
<main class="main-content booking-form-page">
  <!-- Header -->
  <div class="booking-form-header booking-form-header-center">
    <button class="btn-back" id="btnBackFromDetail">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <h1 class="booking-form-title">Chi tiết đặt bàn</h1>
    <div class="header-spacer"></div>
  </div>

  <!-- Restaurant Info Summary -->
  <div class="booking-restaurant-summary">
    <img
      src="{{restaurant.image}}"
      alt="{{restaurant.name}}"
      class="booking-restaurant-image"
    />
    <div class="booking-restaurant-info">
      <h2>{{restaurant.name}}</h2>
      <div class="booking-restaurant-meta">
        <span class="rating">⭐ {{restaurant.average_rating}}</span>
        <span class="cuisine">{{restaurant.cuisine}}</span>
      </div>
      <p class="address">{{restaurant.address}}</p>
    </div>
  </div>

  <!-- Booking Details -->
  <div class="booking-detail-container">
    <!-- Status Badge -->
    <div class="detail-status-section">
      <div class="status-badge-large {{booking.status}}">
        {{#if (eq booking.status "PENDING")}}
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          Đang chờ xác nhận
        {{/if}}
        {{#if (eq booking.status "CONFIRMED")}}
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Đã xác nhận
        {{/if}}
        {{#if (eq booking.status "CANCELLED")}}
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="15" y1="9" x2="9" y2="15"></line>
            <line x1="9" y1="9" x2="15" y2="15"></line>
          </svg>
          Đã hủy
        {{/if}}
      </div>
    </div>

    <!-- Booking Information -->
    <div class="detail-info-section">
      <h3 class="section-title">Thông tin đặt bàn</h3>

      <div class="detail-item">
        <div class="detail-label">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          Ngày đặt
        </div>
        <div class="detail-value">{{booking.date}}</div>
      </div>

      <div class="detail-item">
        <div class="detail-label">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          Giờ đặt
        </div>
        <div class="detail-value">{{booking.time}}</div>
      </div>

      <div class="detail-item">
        <div class="detail-label">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          Số lượng khách
        </div>
        <div class="detail-value">{{booking.people}} người</div>
      </div>

      <div class="detail-item">
        <div class="detail-label">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect x="3" y="8" width="18" height="12" rx="2"></rect>
            <path d="M10 8v-2a2 2 0 0 1 4 0v2"></path>
          </svg>
          Bàn đã chọn
        </div>
        <div class="detail-value">
          {{#each booking.tables}}
            <span class="table-tag">{{this}}</span>
          {{/each}}
        </div>
      </div>
    </div>

    <!-- Customer Information -->
    <div class="detail-info-section">
      <h3 class="section-title">Thông tin liên hệ</h3>

      <div class="detail-item">
        <div class="detail-label">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          Họ và tên
        </div>
        <div class="detail-value">{{booking.customerName}}</div>
      </div>

      <div class="detail-item">
        <div class="detail-label">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
            ></path>
          </svg>
          Số điện thoại
        </div>
        <div class="detail-value">{{booking.customerPhone}}</div>
      </div>

      {{#if booking.notes}}
        <div class="detail-item">
          <div class="detail-label">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
              ></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            Ghi chú
          </div>
          <div class="detail-value">{{booking.notes}}</div>
        </div>
      {{/if}}
    </div>

    <!-- Payment Information -->
    {{#if booking.requireDeposit}}
    <div class="detail-info-section">
      <h3 class="section-title">Thông tin thanh toán</h3>

      <div class="detail-item">
        <div class="detail-label">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <line x1="12" y1="1" x2="12" y2="23"></line>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
          Tiền đặt cọc
        </div>
        <div class="detail-value">{{booking.depositAmount}}đ</div>
      </div>

      <div class="detail-item">
        <div class="detail-label">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
            <line x1="1" y1="10" x2="23" y2="10"></line>
          </svg>
          Trạng thái thanh toán
        </div>
        <div class="detail-value payment-status">{{booking.paymentStatus}}</div>
      </div>
    </div>
    {{/if}}

    {{#if booking.cancelReason}}
      <div class="detail-info-section cancel-reason-section">
        <h3 class="section-title">Lý do hủy</h3>
        <div class="cancel-reason-text">{{booking.cancelReason}}</div>
        {{#if booking.refundStatus}}
          <div class="refund-status-text">✓ {{booking.refundStatus}}</div>
        {{/if}}
      </div>
    {{/if}}
  </div>
</main>

<!-- Fixed Action Button (outside main-content to avoid animation) -->
{{#if (eq booking.status "PENDING")}}
  <div class="booking-form-footer">
    <button
      type="button"
      class="btn-submit-booking"
      onclick="window.location.hash='#/booking/edit/{{booking.id}}'"
    >
      Chỉnh sửa đặt bàn
    </button>
  </div>
{{/if}}
{{#if (eq booking.status "CONFIRMED")}}
  <div class="booking-form-footer">
    <button
      type="button"
      class="btn-submit-booking"
      onclick="window.location.hash='#/booking/edit/{{booking.id}}'"
    >
      Chỉnh sửa đặt bàn
    </button>
  </div>
{{/if}}