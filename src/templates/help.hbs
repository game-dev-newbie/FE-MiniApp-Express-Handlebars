<main class="main-content help-page">
  <!-- Help Header -->
  <div class="booking-form-header booking-form-header-center">
    <button class="btn-back" id="backBtn">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <h1 class="booking-form-title">Trợ giúp</h1>
    <div class="header-spacer"></div>
  </div>

  <!-- FAQ Section -->
  <section class="faq-section">
    <h2 class="section-title">Câu hỏi thường gặp</h2>

    <div class="faq-list">
      {{#each faqs}}
        <div class="faq-item" data-faq-id="{{@index}}">
          <button class="faq-question">
            <span class="question-text">{{this.question}}</span>
            <svg
              class="faq-icon"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="faq-answer">
            <p>{{this.answer}}</p>
          </div>
        </div>
      {{/each}}
    </div>
  </section>

  <!-- Contact Support -->
  <section class="contact-section">
    <div class="contact-card">
      <div class="contact-icon">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
          ></path>
        </svg>
      </div>
      <div class="contact-content">
        <h3>Cần thêm trợ giúp?</h3>
        <p>Liên hệ với chúng tôi qua email hoặc hotline</p>
        <div class="contact-info">
          <a href="mailto:support@dinelink.vn" class="contact-link">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
              ></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            support@dinelink.vn
          </a>
          <a href="tel:1900123456" class="contact-link">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
              ></path>
            </svg>
            1900 123 456
          </a>
        </div>
      </div>
    </div>
  </section>
</main>

