<main class="main-content">
  <!-- Booking Header - Fixed Sticky -->
  <div class="page-header">
    <div class="header-spacer"></div>
    <h1 class="page-title">Lịch đặt bàn</h1>
    <div class="header-spacer"></div>
  </div>

  <!-- Booking Tabs -->
  <div class="booking-tabs">
    <button class="booking-tab active" data-tab="upcoming">Sắp tới</button>
    <button class="booking-tab" data-tab="cancelled">Đã hủy</button>
  </div>

  <!-- Upcoming Bookings -->
  <section class="booking-tab-content active" id="upcoming-tab">
    {{#if upcomingBookings.length}}
      <div class="bookings-list">
        {{#each upcomingBookings}}
          <div class="booking-card {{this.status}}" data-id="{{this.id}}">
            <div class="booking-header">
              <div class="booking-status-badge {{this.status}}">
                {{#if (eq this.status "CONFIRMED")}}✓ Đã xác nhận{{/if}}
                {{#if (eq this.status "PENDING")}}⏳ Chờ xác nhận{{/if}}
              </div>
              <span class="booking-date">{{this.booking_time}}</span>
            </div>
            <div class="booking-content">
              <h3 class="booking-restaurant">{{this.restaurant_name}}</h3>
              <div class="booking-details">
                <div class="booking-detail-item">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                  <span>{{this.people}} người</span>
                </div>
                <div class="booking-detail-item">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <rect
                      x="3"
                      y="4"
                      width="18"
                      height="18"
                      rx="2"
                      ry="2"
                    ></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                  </svg>
                  <span>{{this.table_name}}</span>
                </div>
                {{#if this.depositAmount}}
                  <div class="booking-detail-item">
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <line x1="12" y1="1" x2="12" y2="23"></line>
                      <path
                        d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
                      ></path>
                    </svg>
                    <span>Đặt cọc: {{this.depositAmount}}đ</span>
                  </div>
                {{/if}}
              </div>
              {{#if this.notes}}
                <p class="booking-note">Ghi chú: {{this.notes}}</p>
              {{/if}}
            </div>
            <div class="booking-actions">
              <button
                class="btn-booking-action btn-cancel"
                data-id="{{this.id}}"
              >Hủy đặt</button>
              <button
                class="btn-booking-action btn-primary btn-view-detail"
                data-id="{{this.id}}"
              >Xem chi tiết</button>
            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="empty-state">
        <svg
          width="64"
          height="64"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <h3>Chưa có lịch đặt bàn</h3>
        <p>Đặt bàn ngay để nhận ưu đãi tốt nhất</p>
        <button class="btn-primary" onclick="window.location.hash='#/'">Khám phá nhà hàng</button>
      </div>
    {{/if}}
  </section>

  <!-- Cancelled Bookings -->
  <section class="booking-tab-content" id="cancelled-tab">
    {{#if cancelledBookings.length}}
      <div class="bookings-list">
        {{#each cancelledBookings}}
          <div class="booking-card {{this.status}}" data-id="{{this.id}}">
            <div class="booking-header">
              <div class="booking-status-badge {{this.status}}">✗ Đã hủy</div>
              <span class="booking-date">{{this.booking_time}}</span>
            </div>
            <div class="booking-content">
              <h3 class="booking-restaurant">{{this.restaurant_name}}</h3>
              <div class="booking-details">
                <div class="booking-detail-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                  </svg>
                  <span>{{this.people}} người</span>
                </div>
                <div class="booking-detail-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                  </svg>
                  <span>{{this.table_name}}</span>
                </div>
              </div>
              {{#if this.cancelReason}}
                <p class="booking-cancel-reason">Lý do: {{this.cancelReason}}</p>
              {{/if}}
              {{#if this.refundStatus}}
                <p class="booking-refund-status">✓ Đã hoàn tiền</p>
              {{/if}}
            </div>
            <div class="booking-actions">
              <button class="btn-booking-action btn-outline btn-rebook" data-id="{{this.id}}">Đặt lại</button>
            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="empty-state">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="15" y1="9" x2="9" y2="15"></line>
          <line x1="9" y1="9" x2="15" y2="15"></line>
        </svg>
        <h3>Không có đặt bàn đã hủy</h3>
      </div>
    {{/if}}
  </section>
</main>

<!-- Cancel Confirmation Popup -->
<div id="cancelBookingPopup" class="booking-popup" style="display: none;">
  <div class="booking-popup-overlay"></div>
  <div class="booking-popup-content">
    <div class="popup-icon warning">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
    </div>
    <h3>Xác nhận hủy đặt bàn</h3>
    <p>Bạn có chắc chắn muốn hủy đặt bàn này?</p>
    <p class="refund-notice">✓ Tiền đặt cọc sẽ được hoàn lại trong vòng 3-5 ngày làm việc</p>
    <div class="popup-actions">
      <button class="btn-popup-cancel">Không</button>
      <button class="btn-popup-confirm">Xác nhận hủy</button>
    </div>
  </div>
</div>